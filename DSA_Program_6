//print 1-10
for (var i = 1; i <= 10; i++) {
    console.log(i);
}

//print 10-1
for (var i = 10; i >= 1; i--) {
    console.log(i);
}

//print even numbers from 1-100
for (var i = 1; i <= 100; i++) {
    if (i % 2 === 0) {
        console.log(i);
    }
}

//print odd numbers from 1-100
for (var i = 1; i <= 100; i++) {
    if (i % 2 !== 0) {
        console.log(i);
    }
}

